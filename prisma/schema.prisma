generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-1.1.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid()) @db.VarChar(36)
  email          String          @unique @db.VarChar(191)
  password       String          @db.VarChar(255)
  name           String?         @db.VarChar(191)
  accounts       SocialAccount[]
  posts          Post[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model SocialAccount {
  id             String          @id @default(uuid()) @db.VarChar(36)
  userId         String          @db.VarChar(36)
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       String          @default("FACEBOOK") @db.VarChar(50)
  accountId      String          @db.VarChar(191)
  name           String          @db.VarChar(191)
  avatar         String?         @db.Text
  accessToken    String          @db.Text
  category       String?         @db.VarChar(191)
  isActive       Boolean         @default(true)
  posts          Post[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([userId, platform, accountId])
}

model Post {
  id              String             @id @default(uuid()) @db.VarChar(36)
  userId          String             @db.VarChar(36)
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId       String             @db.VarChar(36)
  account         SocialAccount      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  content         String             @db.Text
  mediaUrl        String?            @db.Text
  mediaType       String             @default("TEXT") @db.VarChar(50)
  reactionsCount  Int                @default(0)
  commentsCount   Int                @default(0)
  lastPolledAt    DateTime?
  scheduledAt     DateTime?
  publishedAt     DateTime?
  status          String             @default("DRAFT") @db.VarChar(50)
  platformPostId  String?            @db.VarChar(191)
  platformPostUrl String?            @db.Text
  errorMessage    String?            @db.Text
  comments        Comment[]
  milestones      MilestoneTrigger[]
  autoReply       AutoReplyRule?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model Comment {
  id                String          @id @default(uuid()) @db.VarChar(36)
  postId            String          @db.VarChar(36)
  post              Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  content           String          @db.Text
  delayMinutes      Int             @default(0)
  scheduledAt       DateTime?
  publishedAt       DateTime?
  status            String          @default("PENDING") @db.VarChar(50)
  platformCommentId String?         @db.VarChar(191)
  errorMessage      String?         @db.Text
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model MilestoneTrigger {
  id                String          @id @default(uuid()) @db.VarChar(36)
  postId            String          @db.VarChar(36)
  post              Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  type              String          @db.VarChar(50)
  threshold         Int
  commentText       String          @db.Text
  isTriggered       Boolean         @default(false)
  triggeredAt       DateTime?
  platformCommentId String?         @db.VarChar(191)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model AutoReplyRule {
  id                   String          @id @default(uuid()) @db.VarChar(36)
  postId               String          @unique @db.VarChar(36)
  post                 Post            @relation(fields: [postId], references: [id], onDelete: Cascade)
  isEnabled            Boolean         @default(true)
  replyText            String          @db.Text
  lastRepliedCommentId String?         @db.VarChar(191)
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
}